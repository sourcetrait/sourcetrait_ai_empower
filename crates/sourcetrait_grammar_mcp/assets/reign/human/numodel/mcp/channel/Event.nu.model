# Channel event envelope
@namepath mcp/channel/Event
@version 0.0.0-1
record<
  id: string,  # base62, generated on send
  from: string,  # namepath, sender
  model: string,  # namepath, for the numodel of the msg data. arbitrary or defined
  msg: oneof<  # the msg either spilled to inbox or inlined
        record<  # spilled to inbox; msg.nuon
            nuon: path,
            size: filesize,
        >,
        record<  # actual data inline
            data: oneof<record<>, table<>>,  # there always need to be some form of data
            attached: oneof<
                nothing,  # no attachments provided
                table<  # attachments
                    file: path,  # relative to the inbox
                    size: filesize,
                >
            >,  # path relative to msg's inbox/attached/<path>
        >,
    >
>