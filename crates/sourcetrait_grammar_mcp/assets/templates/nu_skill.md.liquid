{
  "result": {
    "structuredContent": {
      "created": [
        "/abs/path/to/source/geo/shape",
        "/abs/path/to/source/geo/shape/area/mod.nu",
        "/abs/path/to/source/geo/shape/perimeter/mod.nu"
      ]
